    "/v1/activity": {
      "get": {
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "default 50, max 200"
          }
        ],
        "summary": "This key's recent audit entries (logical paths only)",
        "tags": [
          "discovery"
