{
  "info": {
    "description": "Agent-friendly netdisk API. Authenticate with the `apikey` header (Bearer also accepted). All paths are logical paths inside the key's per-drive root; responses never contain OpenList internals. Long operations run as jobs with long-polling; destructive operations support dry_run.",
    "title": "cloud2api agent gateway (full protocol)",
    "version": "v0.4-1b"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/chunk/add": {
      "post": {
        "parameters": [
          {
            "name": "X-Upload-ID",
            "in": "header",
            "required": false,
            "description": "optional client upload id; repeated staging may reuse it (metadata only, outcome never reset)"
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string"
                  },
                  "filesize": {
                    "description": "total file size in bytes",
                    "type": "integer"
                  },
                  "offset": {
                    "description": "chunk offset from the beginning of the file",
                    "type": "integer"
                  },
                  "uuid": {
                    "description": ">= 10 characters, same for all chunks",
                    "type": "string"
                  }
                },
                "required": [
                  "file",
                  "uuid",
                  "filesize",
                  "offset"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "summary": "Gokapi-compat: stage one chunk (multipart file, uuid, filesize, offset; >=5 MiB except the last); staging acknowledgement, NOT upload completion",
        "tags": [
          "gokapi-compat"
        ]
      }
    },
    "/api/chunk/complete": {
      "post": {
        "parameters": [
          {
            "name": "uuid",
            "in": "header",
            "required": true,
            "description": "the chunk upload uuid"
          },
          {
            "name": "filename",
            "in": "header",
            "required": true,
            "description": "final filename ('base64:...' allowed)"
          },
          {
            "name": "filesize",
            "in": "header",
            "required": true,
            "description": "total size in bytes"
          },
          {
            "name": "contenttype",
            "in": "header",
            "required": false,
            "description": "MIME type"
          },
          {
            "name": "allowedDownloads",
            "in": "header",
            "required": false,
            "description": "default 1; 0 = unlimited"
          },
          {
            "name": "expiryDays",
            "in": "header",
            "required": false,
            "description": "capped at the key's relay max age; 0 = max"
          },
          {
            "name": "nonblocking",
            "in": "header",
            "required": false,
            "description": "true: acknowledge immediately and finish in the background"
          },
          {
            "name": "X-Upload-ID",
            "in": "header",
            "required": false,
            "description": "client-chosen random upload id; adopts the receipt staged with it — a finished attempt answers 409 and needs a fresh id"
          }
        ],
        "summary": "Gokapi-compat: assemble staged chunks into a relay file; returns UploadId/Status (nonblocking=true answers Status=uploading and finishes in the background; poll /api/files/status/{uploadId}). A duplicate completion of a finished attempt answers 409",
        "tags": [
          "gokapi-compat"
        ]
      }
    },
    "/api/files/add": {
      "post": {
        "parameters": [
          {
            "name": "password",
            "in": "header",
            "required": false,
            "description": "rejected with 400 when non-empty: the relay does not support passwords"
          },
          {
            "name": "X-Upload-ID",
            "in": "header",
            "required": false,
            "description": "client-chosen random upload id; the immutable identity of this one attempt — a reused id answers 409, retries need a fresh id"
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "allowedDownloads": {
                    "description": "default 1; 0 = unlimited",
                    "type": "integer"
                  },
                  "expiryDays": {
                    "description": "capped at the key's relay max age (<= 7); 0 = max",
                    "type": "integer"
                  },
                  "file": {
                    "format": "binary",
                    "type": "string"
                  },
                  "password": {
                    "description": "rejected with 400 when non-empty",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "summary": "Gokapi-compat: multipart upload (file, allowedDownloads, expiryDays); returns UploadResult with CRC64 decimal string plus UploadId/Status receipt fields",
        "tags": [
          "gokapi-compat"
        ]
      }
    },
    "/api/files/delete": {
      "delete": {
        "parameters": [
          {
            "name": "id",
            "in": "header",
            "required": true,
            "description": "the file id to delete"
          },
          {
            "name": "delay",
            "in": "header",
            "required": false,
            "description": "seconds to wait before deleting (cancellable via /api/files/restore)"
          }
        ],
        "summary": "Gokapi-compat: delete now, or arm a cancellable delayed deletion",
        "tags": [
          "gokapi-compat"
        ]
      }
    },
    "/api/files/download/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "path parameter"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "file id"
          },
          {
            "name": "increaseCounter",
            "in": "header",
            "required": false,
            "description": "consume one download when true"
          },
          {
            "name": "presignUrl",
            "in": "header",
            "required": false,
            "description": "not supported; answers 400 when true"
          }
        ],
        "summary": "Gokapi-compat: authenticated file download",
        "tags": [
          "gokapi-compat"
        ]
      }
    },
    "/api/files/list": {
      "get": {
        "summary": "Gokapi-compat: this key's relay files (array, or null when empty)",
        "tags": [
          "gokapi-compat"
        ]
      }
    },
    "/api/files/list/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "path parameter"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "file id"
          }
        ],
        "summary": "Gokapi-compat: one relay file's metadata",
        "tags": [
          "gokapi-compat"
        ]
      }
    },
    "/api/files/restore": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "header",
            "required": true,
            "description": "the file id to restore"
          }
        ],
        "summary": "Gokapi-compat: cancel a pending delayed deletion",
        "tags": [
          "gokapi-compat"
        ]
      }
    },
    "/api/files/status/{uploadId}": {
      "get": {
        "parameters": [
          {
            "name": "uploadId",
            "in": "path",
            "required": true,
            "description": "path parameter"
          },
          {
            "name": "uploadId",
            "in": "path",
            "required": true,
            "description": "the upload id returned by /api/files/add or /api/chunk/complete"
          }
        ],
        "summary": "Gokapi-compat additive: one upload receipt of this key (uploading|completed|failed|interrupted); unknown or foreign ids answer 404",
        "tags": [
          "gokapi-compat"
        ]
      }
    },
    "/api/info/config": {
      "get": {
        "summary": "Gokapi-compat: upload parameters (MiB; relay permission)",
        "tags": [
          "gokapi-compat"
        ]
      }
    },
    "/api/info/version": {
      "get": {
        "summary": "Gokapi-compat: server version",
        "tags": [
          "gokapi-compat"
        ]
      }
    },
    "/apidocumentation/openapi.json": {
      "get": {
        "summary": "This document",
        "tags": [
          "assets"
        ]
      }
    },
    "/custom/SKILL.md": {
