      }
    },
    "/v1/drives/{drive}/files": {
      "get": {
        "parameters": [
          {
            "name": "drive",
            "in": "path",
            "required": true,
            "description": "path parameter"
          },
          {
            "name": "drive",
            "in": "path",
            "required": true,
            "description": "drive id"
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "description": "logical file path"
          }
        ],
        "summary": "Stream a file (Range supported); X-C2A-SHA256/X-C2A-CRC64 set when an upload record matches",
        "tags": [
          "files"
        ]
      },
      "put": {
        "parameters": [
          {
            "name": "drive",
            "in": "path",
            "required": true,
            "description": "path parameter"
          },
          {
            "name": "drive",
            "in": "path",
            "required": true,
            "description": "drive id"
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "description": "logical target path"
          },
          {
            "name": "on_conflict",
            "in": "query",
            "required": false,
            "description": "fail (default) | overwrite | rename"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "replay-safe retry within 24h"
          },
          {
            "name": "X-Expected-CRC64",
            "in": "header",
            "required": false,
            "description": "decimal CRC-64/XZ; mismatch deletes the upload and returns 422"
          },
          {
            "name": "X-Expected-SHA256",
            "in": "header",
            "required": false,
            "description": "hex sha256; mismatch deletes the upload and returns 422"
          }
        ],
        "summary": "Upload raw body (Content-Length required) or multipart `file` part; CRC64 (CRC-64/XZ) and SHA-256 computed server-side",
        "tags": [
          "files"
        ]
      }
    },
