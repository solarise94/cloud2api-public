        "summary": "Download a public URL into a drive via OpenList offline download (SimpleHttp); answers 202 {job}",
        "tags": [
          "jobs"
        ]
      }
    },
    "/v1/files": {
      "get": {
        "parameters": [
          {
            "name": "path",
