      }
    },
    "/v1/batch": {
      "post": {
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "replay-safe retry within 24h"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "dry_run": {
                    "type": "boolean"
                  },
                  "ops": {
                    "items": {
                      "properties": {
                        "drive": {
                          "type": "string"
                        },
                        "from": {
                          "description": "move/copy source",
                          "properties": {
                            "drive": {
                              "type": "string"
                            },
                            "path": {
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "on_conflict": {
                          "enum": [
                            "fail",
                            "overwrite",
                            "rename"
                          ],
                          "type": "string"
                        },
                        "op": {
                          "enum": [
                            "mkdir",
                            "delete",
                            "move",
                            "copy"
                          ],
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "paths": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "to": {
                          "description": "move/copy destination",
                          "properties": {
                            "drive": {
                              "type": "string"
                            },
                            "path": {
                              "type": "string"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "required": [
                        "op"
                      ],
                      "type": "object"
                    },
                    "maxItems": 100,
                    "type": "array"
                  }
                },
                "required": [
                  "ops"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "summary": "Up to 100 mkdir/delete/move/copy ops; cross-drive copies turn the batch into a job (202)",
        "tags": [
          "jobs"
        ]
      }
    },
    "/v1/delete": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "paths": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "paths"
                ],
                "type": "object"
              }
            }
